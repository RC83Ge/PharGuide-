# Clé d'API Google Gemini, utilisée uniquement côté serveur (api/gemini.ts).
# En production : Vercel > Project Settings > Environment Variables.
# Ne jamais la préfixer par VITE_ : elle serait alors intégrée au code envoyé aux navigateurs.
GEMINI_API_KEY=

# Uniquement pour le build Android (Capacitor) : adresse du site Vercel qui sert /api/gemini.
# Exemple : VITE_API_BASE_URL=https://pharmaguide.vercel.app
VITE_API_BASE_URL=
